# Open AI
RAG_LLM_PROVIDER="openai_compatible"
# API style: chat_completions (default) or responses
RAG_LLM_API_STYLE="chat_completions"
RAG_LLM_API_KEY=""
RAG_LLM_BASE_URL=""
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_BASE_URL=""
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

