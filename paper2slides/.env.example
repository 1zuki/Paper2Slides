# Open AI
RAG_LLM_PROVIDER="openai_compatible"
# API style: chat_completions (default) or responses
RAG_LLM_API_STYLE="chat_completions"
RAG_LLM_API_KEY=""
RAG_LLM_BASE_URL=""
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_BASE_URL=""
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

# External Codex-compatible gateway (use instead of the variables above)
# RAG_LLM_PROVIDER="codex_gateway"
# CODEX_API_KEY=""
# CODEX_BASE_URL="https://your-gateway.example/backend-api/codex"
# CODEX_MODEL="your-text-model"

# Optional vision-capable provider for slide/poster planning only. RAG and
# summary continue using the RAG_LLM_* settings above. Blank overrides fall
# back to CODEX_API_KEY, CODEX_BASE_URL, and CODEX_MODEL.
# PLANNER_LLM_PROVIDER="codex_gateway"
# PLANNER_LLM_API_KEY=""
# PLANNER_LLM_BASE_URL=""
# PLANNER_LLM_MODEL=""
# PLANNER_LLM_API_STYLE="responses"
# Set true only when the planner endpoint accepts image_url content. The
# configured codex gateway currently works best with text-only planning.
# PLANNER_LLM_ATTACH_FIGURES="false"
# PLANNER_LLM_MAX_TOKENS="12000"
# Research profile planner context size; larger values preserve more extracted
# technical evidence in the planning request.
# PLANNER_LLM_CONTEXT_CHARS="30000"
# CODEX_TIMEOUT_SECONDS="300"

# Image Generation
# provider: openrouter (default), google, or comfyui
IMAGE_GEN_PROVIDER="openrouter"
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=""
IMAGE_GEN_MODEL=""
IMAGE_GEN_RESPONSE_MIME_TYPE="image/png"
GOOGLE_GENAI_BASE_URL=""

# Local ComfyUI (workflow must be exported in API format)
IMAGE_GEN_COMFYUI_BASE_URL="http://127.0.0.1:8188"
IMAGE_GEN_COMFYUI_WORKFLOW=""
IMAGE_GEN_COMFYUI_PROMPT_NODE=""
IMAGE_GEN_COMFYUI_PROMPT_INPUT="text"
IMAGE_GEN_COMFYUI_OUTPUT_NODE=""
IMAGE_GEN_COMFYUI_TIMEOUT_SECONDS="300"
# For academic slides, compose exact titles/text/figures instead of asking
# diffusion to draw scientific labels. Set to false to use the raw workflow.
IMAGE_GEN_COMPOSE_ACADEMIC="true"
